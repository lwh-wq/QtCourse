  <property name="styleSheet">
   <string notr="true">/* 标题样式：Qt兼容版，更醒目且有层次感 */
#titleLabel {
    background: #f8f9fa; /* 浅灰背景更柔和 */
    color: #2c3e50; /* 深灰文字更高级 */
    font-size: 22px;
    font-weight: 600; /* 加粗突出标题 */
    border: none;
    border-bottom: 2px solid #3498db; /* 蓝色下边框更亮眼 */
    padding: 8px 12px;
    border-radius: 4px 4px 0 0; /* 顶部圆角 */
}

/* 主框架：Qt兼容版，简洁舒适 */
#mainFrame {
    border: none;
    background: #f5f7fa; /* 淡蓝灰背景更舒适 */
    padding: 10px; /* 内边距避免内容贴边 */
    border-radius: 6px; /* 整体圆角 */
}

/* 登录框：Qt兼容版，渐变+精致边框 */
#loginFram {
    /* Qt支持的线性渐变，更清新的浅蓝调 */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e3f2fd, stop:1 #bbdefb);
    /* 双层边框模拟阴影效果，Qt兼容 */
    border: 1px solid #90caf9; 
    border-top: 1px solid #e8f4f8;
    border-left: 1px solid #e8f4f8;
    padding: 15px 20px; /* 增加内边距更宽松 */
    border-radius: 12px; /* 更圆润的边角 */
}</string>
